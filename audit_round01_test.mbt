///|
test "new independent round 1: strict folded syntax and diagnostic coordinates" {
  assert_true(@moonabnf.parse(b"s = \"\"\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s\t=\t%S\"A\"\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = %I\"A\"\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = %B1000001 / %D66 / %X43\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = \"a\";comment\t\r\n / \"b\"\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = (\r\n\t\"a\" / \"b\"\r\n )\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = \"a\"\r\n\t\"b\"\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"; heading\r\n\r\ns = \"a\"\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = <a<b>\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = \"\\\"\r\n") is Ok(_))
  assert_true(@moonabnf.parse(b"s = \"a\"\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = \"a\"\r") is Err(_))
  assert_true(@moonabnf.parse(b"s = \"a\"") is Err(_))
  assert_true(@moonabnf.parse(b"s = \"a\"\r\n/ \"b\"\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = \"a\" \"\t\"\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = \"a\";\x7f\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = %x41.42-43\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = %b2\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = %s \"a\"\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = \"a\"\"b\"\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"_s = \"a\"\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"1s = \"a\"\r\n") is Err(_))
  assert_true(@moonabnf.parse(b"s = <>\r\n\x00") is Err(_))
  let d = @moonabnf.parse(b"; hi\r\ns = @\r\n").unwrap_err()
  assert_eq((d.offset, d.line, d.column), (10, 2, 5))
}
